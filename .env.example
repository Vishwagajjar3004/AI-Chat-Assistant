# Copy this file to ".env" and change values if needed. All settings are optional.

# --- Ollama (local LLM server) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# --- Chat behaviour ---
MAX_MESSAGE_LENGTH=8000
MAX_HISTORY_MESSAGES=30

# --- Backend server (keep on localhost; do not expose to the internet) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Frontend ---
BACKEND_URL=http://127.0.0.1:8000

# --- Database (default: data/chat.db) ---
# DATABASE_URL=sqlite:///data/chat.db
